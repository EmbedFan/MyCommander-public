#include <winres.h>
#include "resource.h"
#include "../MyCommander/Version.h"

// FEA-0006 §4: the installer's payload, embedded rather than shipped as a
// side-by-side folder. Tools/RebuildReleaseForInstaller.ps1 (this project's
// own PreBuildEvent) rebuilds MyCommander.exe as Release and copies it,
// plus USERGUIDE.md/LICENSE, into payload\ before rc.exe ever sees these
// lines — see Source/MyCommanderSetup/payload/README.txt for why that
// folder itself isn't checked into git.
IDR_PAYLOAD_MYCOMMANDER RCDATA "payload\\MyCommander.exe"
IDR_PAYLOAD_USERGUIDE   RCDATA "payload\\USERGUIDE.md"
IDR_PAYLOAD_LICENSE     RCDATA "payload\\LICENSE"
// IS-0013: the one real, user-facing plugin today -- see
// RebuildReleaseForInstaller.ps1's own comment for why ExamplePlugin (a
// developer-facing template, not a shipped feature) is deliberately not here.
IDR_PAYLOAD_ZIPPLUGIN   RCDATA "payload\\ZipPlugin.dll"
// EXT-005 / FTP-012: the FTP plugin, staged the same way.
IDR_PAYLOAD_FTPPLUGIN   RCDATA "payload\\FtpPlugin.dll"
// EXT-004 / SFTP-010: the SFTP plugin, staged the same way.
IDR_PAYLOAD_SFTPPLUGIN  RCDATA "payload\\SftpPlugin.dll"

// FEA-0010: the Network Info plugin.
IDR_PAYLOAD_NETINFOPLUGIN RCDATA "payload\\NetInfoPlugin.dll"

// IS-0021: the application icon, twice. As the installer's own icon (Explorer shows it for MyCommanderSetup.exe,
// which is also kept as the uninstaller), and as a payload the installer writes beside MyCommander.exe as
// mycommander.ico, so a Windows Terminal profile (and any shortcut the user makes) can point at it. Referenced
// straight from Resources\, not staged through payload\ -- it is a committed asset, not a build output.
IDI_APPICON ICON "..\\..\\Resources\\mycommander.ico"
IDR_PAYLOAD_ICON RCDATA "..\\..\\Resources\\mycommander.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MC_VERSION_MAJOR,MC_VERSION_MINOR,MC_VERSION_PATCH,MC_VERSION_BUILD
 PRODUCTVERSION MC_VERSION_MAJOR,MC_VERSION_MINOR,MC_VERSION_PATCH,MC_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Attila Gallai"
            VALUE "FileDescription", "MyCommander Setup"
            VALUE "FileVersion", MC_VERSION_STR
            VALUE "InternalName", "MyCommanderSetup"
            VALUE "LegalCopyright", "Copyright (C) Attila Gallai 1985 - 2026"
            VALUE "OriginalFilename", "MyCommanderSetup.exe"
            VALUE "ProductName", "MyCommander"
            VALUE "ProductVersion", MC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
