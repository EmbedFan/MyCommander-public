#include <winres.h>
#include "Version.h"

// IS-0021: the application icon -- one multi-size icon (16, 24, 32, 48, 64, 96, 128, 256 px) built by
// Tools/MakeAppIcon.py from the per-size artwork in Resources/mycommander_extracted. Explorer, the taskbar,
// Alt+Tab and Task Manager use the executable's first icon group.
#define IDI_APPICON 1
IDI_APPICON ICON "..\\..\\Resources\\mycommander.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MC_VERSION_MAJOR,MC_VERSION_MINOR,MC_VERSION_PATCH,MC_VERSION_BUILD
 PRODUCTVERSION MC_VERSION_MAJOR,MC_VERSION_MINOR,MC_VERSION_PATCH,MC_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Attila Gallai"
            VALUE "FileDescription", "MyCommander - Terminal File Commander"
            VALUE "FileVersion", MC_VERSION_STR
            VALUE "InternalName", "MyCommander"
            VALUE "LegalCopyright", "Copyright (C) Attila Gallai 1985 - 2026"
            VALUE "OriginalFilename", "MyCommander.exe"
            VALUE "ProductName", "MyCommander"
            VALUE "ProductVersion", MC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
