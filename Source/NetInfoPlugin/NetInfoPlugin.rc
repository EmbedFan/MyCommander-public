// FEA-0010: NetInfoPlugin.dll's embedded Windows file-version resource, from
// Version.h (same pattern as ZipPlugin.rc / PluginVersionTemplate.rc).

#include <winres.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MCPLUGIN_VERSION_MAJOR,MCPLUGIN_VERSION_MINOR,MCPLUGIN_VERSION_PATCH,MCPLUGIN_VERSION_BUILD
 PRODUCTVERSION MCPLUGIN_VERSION_MAJOR,MCPLUGIN_VERSION_MINOR,MCPLUGIN_VERSION_PATCH,MCPLUGIN_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "MyCommander project"
            VALUE "FileDescription", "Network Info Plugin for MyCommander"
            VALUE "FileVersion", MCPLUGIN_VERSION_STR
            VALUE "InternalName", "NetInfoPlugin"
            VALUE "LegalCopyright", "Copyright (C) Attila Gallai 1985 - 2026"
            VALUE "OriginalFilename", "NetInfoPlugin.dll"
            VALUE "ProductName", "Network Info Plugin"
            VALUE "ProductVersion", MCPLUGIN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
