  <ItemDefinitionGroup>
    <!-- PluginManager::DiscoverAndLoad (Source/MyCommander/main.cpp) scans a
         "Plugins" folder next to whichever MyCommander.exe is actually
         running, which is Build\x64\$(Configuration)\ at the solution root
         when MyCommander.sln built it (never Source\MyCommander\Build,
         the same $(SolutionDir) quirk this project's own top comment
         already notes). Since ZipPlugin is deliberately not part of the
         solution, nothing else puts its DLL there, so this copies it
         after every build, letting a Debug/Release run of the real app
         actually discover it without a manual copy step, same pattern
         as Source/ExamplePlugin/ExamplePlugin.vcxproj. -->
    <PostBuildEvent>
      <Command>if not exist "$(ProjectDir)..\..\Build\$(Platform)\$(Configuration)\Plugins" mkdir "$(ProjectDir)..\..\Build\$(Platform)\$(Configuration)\Plugins"
copy /Y "$(TargetPath)" "$(ProjectDir)..\..\Build\$(Platform)\$(Configuration)\Plugins\"
if not exist "$(ProjectDir)..\MyCommander\Build\$(Platform)\$(Configuration)\Plugins" mkdir "$(ProjectDir)..\MyCommander\Build\$(Platform)\$(Configuration)\Plugins"
copy /Y "$(TargetPath)" "$(ProjectDir)..\MyCommander\Build\$(Platform)\$(Configuration)\Plugins\"</Command>
      <Message>Copying $(TargetFileName) into each MyCommander build output's Plugins folder</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="ZipPlugin.cpp" />
    <!-- Vendored third-party source (DEC-010, AIPrompt/features/FEA-0007-plan.md),
         compiled as C (cl.exe's own default for a .c extension; the
         project's C++20/ConformanceMode settings above don't apply to it).
         C4127 ("conditional expression is constant") is expected and
         harmless here, miniz's own do/while(0)-style macros, confirmed
         by a standalone /W4 compile before this file was vendored; silenced
         only for this one file, not project-wide, so the plugin's own
         source stays held to the full Level4 warning set. -->
    <ClCompile Include="third_party\miniz\miniz.c">
      <DisableSpecificWarnings>4127</DisableSpecificWarnings>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\MyCommanderPluginSdk\McPluginAbi.h" />
    <ClInclude Include="..\MyCommanderPluginSdk\McPluginHost.h" />
    <ClInclude Include="..\MyCommanderPluginSdk\McPluginTypes.h" />
    <ClInclude Include="..\MyCommanderPluginSdk\McPluginVersion.h" />
    <ClInclude Include="Version.h" />
    <ClInclude Include="third_party\miniz\miniz.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- IS-0011: gives ZipPlugin.dll an embedded Windows file-version
         resource (Alt+Enter/FileInfo.cpp already reads this generically for
         any .dll; there was simply nothing to read before this existed),
         via the version numbers in Version.h. -->
    <ResourceCompile Include="ZipPlugin.rc" />
  </ItemGroup>
