<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- FEA-0007: the ZIP MC Plugin, a standalone project, deliberately NOT
       part of MyCommander.sln (same "build like a real third-party plugin
       author would" precedent as Source/ExamplePlugin/). This is currently
       a scaffold only: McPlugin_GetInfo plus a one-shot proof-of-life call
       into the vendored miniz library at Init, logged through the host;
       no menu items, no capabilities declared yet, and no packing,
       unpacking, or archive-browsing logic. See
       AIPrompt/features/FEA-0007-plan.md for the full design this will
       grow into, phase by phase. Because this project is not part of the
       solution, $(SolutionDir) does not resolve here (the same MSBuild
       quirk CLAUDE.md documents for MyCommander.vcxproj), so every path
       below is $(ProjectDir)-relative instead. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{8465E2B8-7FEF-406C-80DC-F92D7772C9BA}</ProjectGuid>
    <RootNamespace>ZipPlugin</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
